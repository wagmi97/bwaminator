# --- Twitter ingestion (race all three, fire on first arrival) ---
# Primary: twitterapi.io WebSocket — P50 251ms, P90 327ms, $0.15/1k tweets
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_WS=wss://ws.twitterapi.io/twitter/tweet/websocket

# Hot redundancy: self-hosted twscrape with cookies + residential proxies (P50 ~500-900ms)
TWSCRAPE_DB_PATH=./data/twscrape.db
TWSCRAPE_PROXIES=                    # comma-separated http://user:pass@host:port

# Cold backup: X API PPU at $0.001/read, polled at 0.5 Hz on top accounts
X_API_BEARER_TOKEN=

# Comma-separated handles
WATCH_ACCOUNTS=elonmusk,realDonaldTrump,DonaldJTrumpJr,EricTrump,AutismCapital,WatcherGuru,disclosetv,spectatorindex

# --- Namer (vision-capable model) ---
ANTHROPIC_API_KEY=
NAMER_MODEL=                         # e.g. a vision-capable chat model id

# --- Image gen (memecoin-permissive providers, ordered by latency) ---
# 1) Primary: Cloudflare Workers AI - FLUX.2 [klein] 4B (P50 0.3-0.5s, edge)
#    No platform refusals. Workers Paid plan = $5/mo with generous Neuron quota.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_FLUX_MODEL=@cf/black-forest-labs/flux-2-klein-4b   # or -9b for higher quality

# 2) Cross-provider redundancy: fal.ai (~1.5s, $0.003/img)
FAL_KEY=
FAL_MODEL=fal-ai/flux/schnell                         # or flux-2/klein when GA

# 3) Third-party redundancy: Replicate (similar posture, slightly slower)
REPLICATE_API_TOKEN=

# 4) Last-resort uncensored fallback: RunPod ComfyUI w/ CHROMA + Pony LoRAs
#    Always-on A6000 ~$240/mo, on-demand serverless ~$5/mo
SELFHOST_IMAGE_ENDPOINT=
SELFHOST_IMAGE_AUTH=
RUNPOD_CHECKPOINT=flux-schnell-chroma
RUNPOD_LORA=

# Race primary + fallback in parallel (uses more compute, lower p99)
IMAGE_GEN_RACE=false

# --- Metadata + image hosting (upload in parallel to all, use first success URL) ---
# Primary: Cloudflare R2 (cheapest, fast, 99.99% SLA)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_BASE_URL=

# Secondary: BunnyCDN Storage (different infra, cross-provider redundancy)
BUNNY_STORAGE_ZONE=
BUNNY_ACCESS_KEY=
BUNNY_PUBLIC_BASE_URL=

# Tertiary: Pinata IPFS (decentralized, no SPOF)
PINATA_JWT=

# --- Solana / pumpfun deploy ---
SOLANA_RPC_URL=https://beta.helius-rpc.com/?api-key=YOUR_KEY
DEPLOYER_KEYPAIR_PATH=./keys/deployer.json
NONCE_AUTHORITY_KEYPAIR_PATH=./keys/nonce_authority.json
NONCE_ACCOUNT_PUBKEYS=               # comma-separated, pre-created
ALT_PUBKEYS=                         # comma-separated, pre-published

# --- Landing services (race all, take first to land) ---
NEXTBLOCK_ENDPOINT=https://ny.nextblock.io
NEXTBLOCK_API_KEY=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
ZERO_SLOT_ENDPOINT=https://ny1.0slot.trade
ZERO_SLOT_KEY=
HELIUS_SENDER_ENDPOINT=https://sender.helius-rpc.com
HELIUS_SENDER_KEY=
ASTRALANE_ENDPOINT=https://lane.astralane.io
ASTRALANE_KEY=

# --- Strategy ---
SNIPE_SOL_AMOUNT=2.0                 # how much SOL to throw at the curve on creation
PRIORITY_FEE_LAMPORTS_PER_CU=2860000 # 2.86 lamports/CU (matches bwam baseline)
LANDING_TIP_LAMPORTS=1000000         # 0.001 SOL per relayer

# Mint pool (pre-grinded pump-suffix keypairs)
MINT_POOL_TARGET_SIZE=200             # keep N keypairs warm
MINT_POOL_DIR=./mint_pool             # one .json per pre-grinded keypair

# Quality / dedup gates
DEDUP_WINDOW_SECONDS=300              # don't fire twice for similar topics within window
MIN_AUTHOR_FOLLOWERS=100000           # only fire on accounts with this many followers
SKIP_REPLIES=true
SKIP_RETWEETS=false                   # retweets are sometimes the only signal

DRY_RUN=true
